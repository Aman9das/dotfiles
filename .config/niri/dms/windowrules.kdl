// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1789076310919802125 @name=be.alexandervanhee.gradia
window-rule {
    match app-id="^be.alexandervanhee.gradia$"
    open-floating true
}

// @id=wr_1789364535359612581 @name=steam
window-rule {
    match app-id="^steam$"
    open-maximized true
}

// @id=wr_1789690054942483676 @name=com.mitchellh.ghostty
window-rule {
    match app-id="^com.mitchellh.ghostty$"
    background-effect {
        blur true
    }
}

// @id=wr_1790379767511246295 @name=Slay the Spire 2
window-rule {
    match app-id="^Slay the Spire 2$"
    open-maximized true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
